---
/**
 * MethodList.astro — recipe steps as Roman-numeral plate entries.
 * items: Array<{ step: string; tip?: string }>
 */

interface MethodItem {
  step: string;
  tip?: string;
}

interface Props {
  items: MethodItem[];
}

const { items } = Astro.props;

function toRomanLower(n: number): string {
  const vals = [1000,900,500,400,100,90,50,40,10,9,5,4,1];
  const syms = ['m','cm','d','cd','c','xc','l','xl','x','ix','v','iv','i'];
  let result = '';
  for (let i = 0; i < vals.length; i++) {
    while (n >= vals[i]) { result += syms[i]; n -= vals[i]; }
  }
  return result;
}
---

<ol class="method-list">
  {items.map((item, i) => (
    <li class="method-list__row">
      <div class="method-list__grid">
        <span class="method-list__num">{toRomanLower(i + 1)}.</span>
        <div class="method-list__content">
          <p class="method-list__step lede">{item.step}</p>
          {item.tip && (
            <p class="method-list__tip caps">※ {item.tip}</p>
          )}
        </div>
      </div>
      <div class="hairline method-list__divider"></div>
    </li>
  ))}
</ol>

<style>
  .method-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .method-list__row {
    padding-block: var(--space-4);
  }
  .method-list__grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    align-items: start;
  }
  .method-list__num {
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: var(--fs-h3);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    min-width: 2.5ch;
    line-height: var(--lh-lede);
    padding-top: 0.05em;
  }
  .method-list__step {
    font-family: var(--ff-serif);
    font-size: var(--fs-lede);
    line-height: var(--lh-lede);
    color: var(--fg);
    margin: 0;
  }
  .method-list__tip {
    color: var(--rule-strong);
    margin: var(--space-2) 0 0 0;
    font-size: var(--fs-caps);
    letter-spacing: var(--tracking-caps);
  }
  .method-list__divider {
    margin-top: var(--space-4);
  }
  .method-list__row:last-child .method-list__divider {
    display: none;
  }
</style>
