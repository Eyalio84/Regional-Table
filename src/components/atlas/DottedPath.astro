---
/**
 * DottedPath.astro — SVG dotted path between two DOM elements.
 * Calculates positions client-side and animates path draw on mount.
 * Respects prefers-reduced-motion.
 */

interface Props {
  fromId: string;
  toId: string;
  curve?: 'straight' | 'arc';
}

const { fromId, toId, curve = 'arc' } = Astro.props;

const uid = `dp-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class="dotted-path"
  id={uid}
  data-from-id={fromId}
  data-to-id={toId}
  data-curve={curve}
  aria-hidden="true"
  style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;overflow:visible;"
>
  <path
    class="dotted-path__line"
    fill="none"
    stroke="var(--rule-strong)"
    stroke-width="1"
    stroke-dasharray="3 5"
  />
</svg>

<style>
  @keyframes drawPath {
    to { stroke-dashoffset: 0; }
  }
  .dotted-path__line {
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dotted-path__line.animating {
      animation: drawPath var(--motion-slow, 800ms) var(--ease-deliberate, cubic-bezier(0.4,0,0.2,1)) forwards;
    }
  }
</style>

<script is:inline>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function init() {
    document.querySelectorAll('svg.dotted-path').forEach(function (svg) {
      var fromId = svg.getAttribute('data-from-id');
      var toId = svg.getAttribute('data-to-id');
      var curveType = svg.getAttribute('data-curve');
      var fromEl = fromId ? document.getElementById(fromId) : null;
      var toEl = toId ? document.getElementById(toId) : null;
      if (!fromEl || !toEl) return;

      var parent = svg.offsetParent || svg.parentElement;

      function draw() {
        var parentRect = parent ? parent.getBoundingClientRect() : { left: 0, top: 0 };
        var fromRect = fromEl.getBoundingClientRect();
        var toRect = toEl.getBoundingClientRect();

        var x1 = fromRect.left + fromRect.width / 2 - parentRect.left;
        var y1 = fromRect.top + fromRect.height / 2 - parentRect.top;
        var x2 = toRect.left + toRect.width / 2 - parentRect.left;
        var y2 = toRect.top + toRect.height / 2 - parentRect.top;

        var pathEl = svg.querySelector('.dotted-path__line');
        var d;
        if (curveType === 'arc') {
          var mx = (x1 + x2) / 2;
          var my = Math.min(y1, y2) - Math.abs(x2 - x1) * 0.25;
          d = 'M ' + x1 + ' ' + y1 + ' Q ' + mx + ' ' + my + ' ' + x2 + ' ' + y2;
        } else {
          d = 'M ' + x1 + ' ' + y1 + ' L ' + x2 + ' ' + y2;
        }
        pathEl.setAttribute('d', d);

        if (!reduced) {
          var length = pathEl.getTotalLength();
          pathEl.style.strokeDasharray = '3 5';
          pathEl.style.strokeDashoffset = String(length);
          pathEl.classList.add('animating');
        } else {
          pathEl.style.strokeDashoffset = '0';
        }
      }

      draw();
      window.addEventListener('resize', draw);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
