---
/**
 * LegendCallout.astro — map-legend styled integrity-line callout.
 * severity: "absolute" | "strong" | "mild" (default: "strong")
 */

interface Props {
  rule?: string;
  severity?: 'absolute' | 'strong' | 'mild';
}

const { rule, severity = 'strong' } = Astro.props;

const labelMap = {
  absolute: 'INTEGRITY LINE',
  strong: 'RULE',
  mild: 'SUGGESTION',
};

const label = labelMap[severity];
---

<div class={`legend-callout legend-callout--${severity}`}>
  <div class="legend-callout__label caps">{label}</div>
  <div class="legend-callout__rule lede">
    <slot>{rule}</slot>
  </div>
</div>

<style>
  .legend-callout {
    border-left: 3px solid var(--accent);
    padding: var(--space-4) var(--space-5);
    background: color-mix(in srgb, var(--bg) 94%, var(--accent) 6%);
    margin-block: var(--space-5);
  }
  .legend-callout__label {
    color: var(--accent);
    margin-bottom: var(--space-2);
    letter-spacing: var(--tracking-caps);
  }
  .legend-callout__rule {
    font-family: var(--ff-serif);
    font-size: var(--fs-lede);
    line-height: var(--lh-lede);
    color: var(--fg);
    font-style: italic;
  }
</style>
