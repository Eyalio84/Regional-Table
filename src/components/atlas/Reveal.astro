---
/**
 * Reveal.astro — IntersectionObserver fade-in wrapper.
 * Adds .reveal class; script adds .is-visible when 10% visible.
 * Uses window.__rtReveal flag to avoid duplicating observer script.
 */
---

<div class="reveal">
  <slot />
</div>

<script is:inline>
if (!window.__rtReveal) {
  window.__rtReveal = true;

  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduced) {
    // Make all reveal elements immediately visible
    document.querySelectorAll('.reveal').forEach(function (el) {
      el.classList.add('is-visible');
    });
  } else {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal').forEach(function (el) {
      observer.observe(el);
    });
  }
}
</script>
