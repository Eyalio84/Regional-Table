---
/**
 * ask.astro — Master Chef dedicated chat page.
 *
 * The Master Chef holds every kitchen. Ask a cross-regional question,
 * or select a specific region from the carousel inside the panel.
 *
 * FloatingChefPill self-hides here (handled in FloatingChefPill.astro).
 * ExpertChatPanel receives regionId="master" which — as of M4 fix — keeps
 * the region carousel visible so users can navigate between regions.
 *
 * Backend: POST to cuisine-expert API (M5 concern). Messages will 404 until
 * the backend endpoint for regionId="master" is deployed in M5.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ExpertChatPanel from '../components/chat/ExpertChatPanel';
import RuleLine from '../components/atlas/RuleLine.astro';
---

<BaseLayout
  title="Ask the Master Chef — The Regional Table"
  description="The Master Chef holds every kitchen. Ask a cross-regional question, or select a specific region and consult the expert who knows it."
  region="neutral"
>
  <div class="ask-page">

    <!-- Coordinate strip (inline, no CoordinateStrip component — plain text variant for this page) -->
    <div class="ask-coord-strip container">
      <span class="caps ask-coord-text">0.00&deg;N &middot; 0.00&deg;E &middot; MASTER CHEF &middot; Plate &mdash;</span>
      <RuleLine weight="strong" />
    </div>

    <div class="ask-header container">
      <h1 class="ask-title">Ask the Master Chef</h1>
      <p class="ask-lede">
        <em>The Master Chef holds every kitchen. Ask a cross-regional question, or tell me what you want to cook.</em>
      </p>
    </div>

    <div class="ask-panel-wrap">
      <ExpertChatPanel
        client:visible
        regionId="master"
        contextSeed="I'm the Master Chef. Every kitchen is open. What do you want to understand?"
        placeholder="Ask a cross-regional question, or ask about a specific dish..."
      />
    </div>

  </div>
</BaseLayout>

<style>
  .ask-page {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  .ask-coord-strip {
    padding-block: var(--space-4) 0;
  }
  .ask-coord-text {
    font-family: var(--ff-sans);
    font-size: var(--fs-caps);
    letter-spacing: var(--tracking-coord, var(--tracking-caps));
    color: var(--rule-strong);
  }

  .ask-header {
    padding-block: var(--space-6) var(--space-4);
    max-width: 640px;
  }
  .ask-title {
    font-family: var(--ff-serif);
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 400;
    color: var(--fg);
    margin: 0 0 var(--space-4);
    line-height: 1.15;
  }
  .ask-lede {
    font-family: var(--ff-serif);
    font-size: var(--fs-lede);
    color: var(--rule-strong);
    line-height: var(--lh-lede);
    font-style: italic;
    margin: 0;
  }

  .ask-panel-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin: var(--space-6) auto var(--space-8);
    width: 100%;
    max-width: 780px;
    padding-inline: var(--space-5);
    min-height: 560px;
  }

  /* The ExpertChatPanel renders as a full-height flex column */
  .ask-panel-wrap > div {
    flex: 1;
    border: 1px solid var(--rule-faint);
    border-radius: 4px;
    overflow: hidden;
    min-height: 520px;
  }
</style>
