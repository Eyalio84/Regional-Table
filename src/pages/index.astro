---
/**
 * index.astro — Homepage hub.
 *
 * Three scroll-frames (each ~100vh desktop, stacking on mobile):
 *   Frame 1 — Full-bleed editorial cover: photo hero, wordmark, issue line, scroll arrow
 *   Frame 2 — Atlas map: "Five Kitchens, Five Voices" + MapSVG + 5 region mini-cards
 *   Frame 3 — Featured plates: 3 recipe cards (Ragù, Dashi, Chopped Cheese) + view all
 *
 * Hero image uses plain <img> — NO duotone (heroes are full-color per design system).
 * BaseLayout region="neutral" applied.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MapSVG from '../components/atlas/MapSVG.astro';
import RuleLine from '../components/atlas/RuleLine.astro';

// Pull the 3 featured recipes
const allRecipes = await getCollection('recipes');
const featuredSlugs = ['ragu-napoletano', 'dashi', 'chopped-cheese'];
const featuredRecipes = featuredSlugs
  .map((s) => allRecipes.find((r) => r.data.slug === s || r.id === s))
  .filter(Boolean);

// Region mini-card data (voice quotes pulled from region YAMLs)
const regions = [
  {
    slug: 'neapolitan',
    expertVoice: 'Neapolitan Nonna',
    voiceQuote: "Siediti. Cosa vuoi imparare oggi? I'm here to tell you what the recipes won't.",
  },
  {
    slug: 'lyonnais',
    expertVoice: 'Lyonnais Chef',
    voiceQuote: "Bien. What do you want to understand? I don't do small talk. I do technique.",
  },
  {
    slug: 'cajun-creole',
    expertVoice: 'Cajun Grandmother + Creole Matriarch',
    voiceQuote: 'Mais, cher — sit down. You hungry for knowledge or you just think you know gumbo already?',
  },
  {
    slug: 'nyc-street-food',
    expertVoice: 'NYC Street Food Veteran',
    voiceQuote: "Yo — what do you wanna know? I been out here since the 80s. You want the real deal or the tourist version?",
  },
  {
    slug: 'washoku',
    expertVoice: 'Shokunin Master',
    voiceQuote: 'Welcome. Sit quietly. Tell me what you wish to understand — I will show you what you have been doing wrong.',
  },
];

const REGION_LABELS: Record<string, string> = {
  'neapolitan':      'Neapolitan',
  'lyonnais':        'Lyonnais',
  'cajun-creole':    'Cajun-Creole',
  'nyc-street-food': 'NYC Street Food',
  'washoku':         'Washoku',
};
---

<BaseLayout
  title="The Regional Table — No. I · MMXXVI"
  description="Five regional cuisine experts, five distinct voices. Browse recipes anchored to place and consult the expert who knows the kitchen you care about."
  region="neutral"
>

  <!-- ═══════════════════════════════════════════
       FRAME 1 — Editorial Cover
  ═══════════════════════════════════════════ -->
  <section class="frame frame-cover" aria-label="Cover">
    <img
      class="cover-img"
      src="https://images.unsplash.com/photo-1598866594230-a7c12756260f?w=1800&q=80"
      alt="Ragù Napoletano — slow-cooked Sunday meat sauce"
      loading="eager"
      decoding="async"
    />
    <div class="cover-overlay" aria-hidden="true"></div>

    <div class="cover-text">
      <p class="cover-issue caps">No. I · MMXXVI · Spring</p>
      <h1 class="cover-wordmark">The Regional Table</h1>
    </div>

    <a class="cover-scroll-arrow" href="#atlas" aria-label="Scroll to atlas">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M10 3v14M4 11l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </section>

  <!-- ═══════════════════════════════════════════
       FRAME 2 — Atlas Map
  ═══════════════════════════════════════════ -->
  <section class="frame frame-atlas container" id="atlas" aria-label="Five regions">

    <div class="atlas-header">
      <h2 class="atlas-headline">Five Kitchens, Five Voices</h2>
      <p class="atlas-lede">
        <em>Each region carries an expert. Each expert carries a rule you do not know you are breaking.</em>
      </p>
    </div>

    <RuleLine weight="hair" />

    <div class="atlas-map-wrap">
      <MapSVG />
    </div>

    <RuleLine weight="hair" />

    <ol class="region-row" aria-label="Five regions">
      {regions.map((r) => (
        <li class="region-mini">
          <a href={`/regions/${r.slug}`} class="region-mini__link">
            <p class="region-mini__voice caps">{r.expertVoice}</p>
            <p class="region-mini__quote">&ldquo;{r.voiceQuote}&rdquo;</p>
            <span class="region-mini__cta caps">Enter &rarr;</span>
          </a>
        </li>
      ))}
    </ol>

  </section>

  <!-- ═══════════════════════════════════════════
       FRAME 3 — Featured Plates
  ═══════════════════════════════════════════ -->
  <section class="frame frame-plates container" id="plates" aria-label="Featured plates">

    <p class="plates-label caps">This Week&rsquo;s Plates</p>
    <RuleLine weight="strong" />

    <ol class="plates-grid" aria-label="Featured recipes">
      {featuredRecipes.map((recipe) => {
        if (!recipe) return null;
        const slug = recipe.data.slug ?? recipe.id;
        const regionSlug = recipe.data.region as string;
        return (
          <li class="plate-card">
            <a href={`/recipes/${slug}`} class="plate-card__link">
              <div class="plate-card__thumb">
                <img
                  src={recipe.data.heroImage}
                  alt={recipe.data.title}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="plate-card__body">
                <p class="caps plate-card__region">{REGION_LABELS[regionSlug] ?? regionSlug}</p>
                <h3 class="plate-card__title">{recipe.data.title}</h3>
                <p class="caps plate-card__meta">{recipe.data.time.total} &middot; {recipe.data.difficulty}</p>
              </div>
            </a>
          </li>
        );
      })}
    </ol>

    <div class="plates-footer">
      <a href="/recipes/" class="plates-all-link caps">View all plates &rarr;</a>
    </div>

  </section>

  <!-- Footer rule -->
  <footer class="home-footer container" role="contentinfo">
    <RuleLine weight="strong" />
    <p class="home-footer__line caps">
      The Regional Table &middot; No. I &middot; MMXXVI &middot;
      <a href="/about" class="home-footer__about">About</a>
    </p>
  </footer>

</BaseLayout>

<style>
  /* ── Shared frame base ── */
  .frame {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* ── Frame 1: Cover ── */
  .frame-cover {
    position: relative;
    overflow: hidden;
    background: var(--ink);
  }
  .cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }
  .cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(26, 22, 17, 0.82) 0%,
      rgba(26, 22, 17, 0.32) 50%,
      rgba(26, 22, 17, 0.10) 100%
    );
  }
  .cover-text {
    position: relative;
    z-index: 2;
    padding: var(--space-8) var(--space-6) var(--space-9);
    margin-top: auto;
  }
  .cover-issue {
    font-family: var(--ff-sans);
    font-size: var(--fs-caps);
    letter-spacing: var(--tracking-caps);
    color: var(--cream);
    opacity: 0.8;
    margin: 0 0 var(--space-3);
  }
  .cover-wordmark {
    font-family: var(--ff-serif);
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 400;
    color: var(--cream);
    letter-spacing: -0.01em;
    line-height: 1.0;
    margin: 0;
  }
  .cover-scroll-arrow {
    position: absolute;
    bottom: var(--space-6);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: var(--cream);
    opacity: 0.55;
    text-decoration: none;
    transition: opacity 150ms ease;
    animation: bob 2.4s ease-in-out infinite;
  }
  .cover-scroll-arrow:hover { opacity: 0.9; }

  @keyframes bob {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(5px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover-scroll-arrow { animation: none; }
  }

  /* ── Frame 2: Atlas ── */
  .frame-atlas {
    padding-block: var(--space-9) var(--space-8);
    gap: var(--space-6);
  }
  .atlas-header {
    text-align: center;
    padding-block: var(--space-5) var(--space-3);
  }
  .atlas-headline {
    font-family: var(--ff-serif);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--fg);
    margin: 0 0 var(--space-4);
  }
  .atlas-lede {
    font-family: var(--ff-serif);
    font-size: var(--fs-lede);
    color: var(--rule-strong);
    font-style: italic;
    margin: 0;
    line-height: var(--lh-lede);
  }
  .atlas-map-wrap {
    max-width: 720px;
    margin-inline: auto;
    width: 100%;
  }
  .region-row {
    list-style: none;
    margin: 0;
    padding: var(--space-5) 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-5);
  }
  .region-mini__link {
    display: block;
    padding: var(--space-4);
    border: 1px solid var(--rule-faint);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease;
  }
  .region-mini__link:hover { border-color: var(--accent); }
  .region-mini__voice {
    font-size: var(--fs-caps);
    letter-spacing: var(--tracking-caps);
    color: var(--accent);
    margin: 0 0 var(--space-2);
  }
  .region-mini__quote {
    font-family: var(--ff-serif);
    font-size: var(--fs-body);
    color: var(--fg);
    margin: 0 0 var(--space-3);
    line-height: 1.45;
    font-style: italic;
  }
  .region-mini__cta {
    font-size: var(--fs-caps);
    letter-spacing: var(--tracking-caps);
    color: var(--rule-strong);
  }
  .region-mini__link:hover .region-mini__cta { color: var(--accent); }

  /* ── Frame 3: Featured plates ── */
  .frame-plates {
    padding-block: var(--space-8) var(--space-9);
  }
  .plates-label {
    font-size: var(--fs-caps);
    letter-spacing: var(--tracking-caps);
    color: var(--rule-strong);
    margin: 0 0 var(--space-4);
  }
  .plates-grid {
    list-style: none;
    margin: var(--space-7) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-7);
  }
  .plate-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .plate-card__link:hover .plate-card__title { color: var(--accent); }
  .plate-card__thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: var(--space-4);
  }
  .plate-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease;
  }
  .plate-card__link:hover .plate-card__thumb img { transform: scale(1.03); }
  .plate-card__body { padding-inline: var(--space-1); }
  .plate-card__region {
    font-size: var(--fs-caps);
    letter-spacing: var(--tracking-caps);
    color: var(--accent);
    margin: 0 0 var(--space-2);
  }
  .plate-card__title {
    font-family: var(--ff-serif);
    font-size: var(--fs-h3);
    color: var(--fg);
    margin: 0 0 var(--space-2);
    line-height: 1.2;
    transition: color 150ms ease;
  }
  .plate-card__meta {
    color: var(--rule-strong);
    font-size: var(--fs-caps);
    letter-spacing: var(--tracking-caps);
    margin: 0;
  }
  .plates-footer {
    margin-top: var(--space-8);
    text-align: center;
  }
  .plates-all-link {
    font-size: var(--fs-caps);
    letter-spacing: var(--tracking-caps);
    color: var(--rule-strong);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-faint);
    padding-bottom: 2px;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .plates-all-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ── Footer rule ── */
  .home-footer {
    padding-block: var(--space-5) var(--space-7);
  }
  .home-footer__line {
    font-size: var(--fs-caps);
    letter-spacing: var(--tracking-caps);
    color: var(--rule-strong);
    margin: 0;
    text-align: center;
  }
  .home-footer__about {
    color: var(--rule-strong);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-faint);
    padding-bottom: 1px;
    transition: color 150ms ease;
  }
  .home-footer__about:hover { color: var(--accent); }
</style>
